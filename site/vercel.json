{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/services-3/sampleregistration", "destination": "https://app.sacredsamplingsolutions.com/sampleregistration", "permanent": false },
    { "source": "/services-3/sampleregistration/:path*", "destination": "https://app.sacredsamplingsolutions.com/sampleregistration/:path*", "permanent": false },
    { "source": "/sampleregistration", "destination": "https://app.sacredsamplingsolutions.com/sampleregistration", "permanent": false },
    { "source": "/sampleregistration.html", "destination": "https://app.sacredsamplingsolutions.com/sampleregistration", "permanent": false },
    { "source": "/sampleregistration/:path*", "destination": "https://app.sacredsamplingsolutions.com/sampleregistration/:path*", "permanent": false },
    { "source": "/chain-of-custody", "destination": "https://app.sacredsamplingsolutions.com/chain-of-custody", "permanent": false },
    { "source": "/chain-of-custody/:path*", "destination": "https://app.sacredsamplingsolutions.com/chain-of-custody/:path*", "permanent": false },

    { "source": "/go/fb", "destination": "/kits.html?utm_source=facebook&utm_medium=paid_social&utm_campaign=shop", "permanent": false },
    { "source": "/go/fb-post", "destination": "/kits.html?utm_source=facebook&utm_medium=social&utm_campaign=shop", "permanent": false },
    { "source": "/go/ig", "destination": "/kits.html?utm_source=instagram&utm_medium=social&utm_campaign=shop", "permanent": false },
    { "source": "/go/pfas", "destination": "/kit-pfas.html?utm_source=facebook&utm_medium=paid_social&utm_campaign=pfas", "permanent": false }
  ]
}
