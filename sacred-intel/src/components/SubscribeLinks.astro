---
import { SITE } from '../lib/site.js';
const { label = 'Listen & subscribe' } = Astro.props;
---
<div class="subscribe-wrap">
  {label && <span class="meta" style="margin-bottom:12px;display:block">{label}</span>}
  <div class="subscribe">
    {SITE.subscribe.map((s) => (
      <a href={s.href} aria-label={s.name} rel={s.href.startsWith('#') ? 'nofollow' : undefined}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          {s.slug === 'rss' ? (
            <g><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1.5" fill="currentColor"/></g>
          ) : (
            <g><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></g>
          )}
        </svg>
        {s.name}
      </a>
    ))}
  </div>
</div>
