---
import { SITE } from '../lib/site.js';
import { seriesList } from '../lib/series.js';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/">
          <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
            <defs><linearGradient id="fm" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#A78BFA"/><stop offset="1" stop-color="#8B5CF6"/></linearGradient></defs>
            <rect width="100" height="100" rx="24" fill="#1c1c22"/>
            <g fill="url(#fm)"><rect x="30" y="44" width="6" height="12" rx="3"/><rect x="41" y="34" width="6" height="32" rx="3"/><rect x="52" y="26" width="6" height="48" rx="3"/><rect x="63" y="38" width="6" height="24" rx="3"/></g>
          </svg>
          <span>Sacred Intel</span>
        </a>
        <p class="foot-about">{SITE.tagline}</p>
        <div class="subscribe">
          {SITE.subscribe.slice(0, 4).map((s) => <a href={s.href}>{s.name}</a>)}
        </div>
      </div>
      <div>
        <h4>Series</h4>
        {seriesList.map((s) => <a href={`/series/${s.slug}/`}>{s.name}</a>)}
        <a href="/episodes/">All Episodes</a>
      </div>
      <div>
        <h4>Explore</h4>
        <a href="/articles/">Articles / Intel</a>
        <a href="/about/">About Sacred Intel</a>
        <a href="/guests/">Become a Guest</a>
        <a href="/contact/">Contact</a>
        <a href="/podcast.xml">Podcast RSS</a>
      </div>
      <div>
        <h4>Follow</h4>
        {SITE.social.map((s) => <a href={s.href}>{s.name}</a>)}
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </div>
    </div>
    <div class="foot-bottom">
      <span>&copy; {year} Sacred Intel. All rights reserved.</span>
      <span class="mono">Independent media · Reported &amp; sourced</span>
    </div>
  </div>
</footer>
