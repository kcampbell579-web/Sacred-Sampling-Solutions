---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Newsletter from '../../components/Newsletter.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', (a) => !a.data.draft);
  return articles.map((art) => ({
    params: { slug: art.slug },
    props: { art, all: articles },
  }));
}

const { art, all } = Astro.props;
const { data } = art;
const { Content } = await art.render();
const date = data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

const related = all
  .filter((a) => a.slug !== art.slug)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base title={data.title} description={data.description} type="article" image={data.image || '/favicon.svg'}>
  <section class="page-hero">
    <div class="wrap page-hero-inner" style="max-width:820px">
      <a href="/articles/" class="backlink" style="color:var(--d-text-3);font-family:var(--mono);font-size:.76rem;letter-spacing:.06em;text-transform:uppercase">← All articles</a>
      <span class="chip" style="margin:16px 0 0">{data.category}</span>
      <h1>{data.title}</h1>
      <p class="meta" style="margin-top:16px">By {data.author} · {date}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap-narrow">
      <article class="prose">
        <p style="font-size:1.2rem;color:var(--ink-2)">{data.description}</p>
        <hr />
        <Content />
      </article>
      {data.topics.length > 0 && (
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:32px">
          {data.topics.map((t) => <span class="chip">{t}</span>)}
        </div>
      )}
    </div>
  </section>

  {related.length > 0 && (
    <section class="section section-paper">
      <div class="wrap">
        <div class="head-row"><h2>More Intel</h2><a href="/articles/" class="btn btn-ghost btn-sm">All articles →</a></div>
        <div class="grid grid-3">{related.map((a) => <ArticleCard article={a} />)}</div>
      </div>
    </section>
  )}

  <section class="section"><div class="wrap"><Newsletter /></div></section>
</Base>
