---
import Base from '../layouts/Base.astro';
import { SITE } from '../lib/site.js';
---
<Base title="Contact" description="Get in touch with Sacred Intel — story tips, corrections, press, and partnership inquiries.">
  <section class="page-hero">
    <div class="wrap page-hero-inner">
      <span class="eyebrow">Contact</span>
      <h1>Get in touch</h1>
      <p>Story tips, corrections, press, partnerships — we read everything.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="grid grid-2" style="gap:48px;align-items:start">
        <div class="side-block" style="background:var(--paper);padding:28px">
          <h4 style="margin-bottom:14px">Send a message</h4>
          <form class="form" action="#" method="post" novalidate>
            <div class="row">
              <div class="field"><label for="c-name">Name</label><input id="c-name" name="name" type="text" required /></div>
              <div class="field"><label for="c-email">Email</label><input id="c-email" name="email" type="email" required /></div>
            </div>
            <div class="field">
              <label for="c-reason">Reason</label>
              <select id="c-reason" name="reason">
                <option>Story tip</option>
                <option>Correction</option>
                <option>Press / media</option>
                <option>Partnership / sponsorship</option>
                <option>Something else</option>
              </select>
            </div>
            <div class="field"><label for="c-msg">Message</label><textarea id="c-msg" name="message" required></textarea></div>
            <button type="submit" class="btn btn-primary">Send message</button>
          </form>
        </div>

        <div class="prose">
          <h2>Other ways to reach us</h2>
          <p>Email is the fastest route: <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <h3>Got a tip?</h3>
          <p>Know about a disaster, exposure, or failure that deserves a closer look? Tell us what you're seeing — anonymity respected on request.</p>
          <h3>Want to be on the show?</h3>
          <p>Head to the <a href="/guests/">Guests page</a> to pitch yourself or a story.</p>
          <h3>Corrections</h3>
          <p>We source every claim and we fix mistakes fast. If something's off, send the episode, the timestamp, and the correction.</p>
          <h3>Follow along</h3>
          <div class="subscribe" style="margin-top:10px">
            {SITE.social.map((s) => <a href={s.href}>{s.name}</a>)}
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
